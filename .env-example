# Copy this file to .env and fill in the real values, then regenerate the
# encrypted env file:
#
#   cp .env-example .env
#   dart run nylo_framework:main make:env
#
# .env is gitignored (it holds your keys) — never commit it. The APK reads the
# compiled lib/bootstrap/env.g.dart, not .env directly.

APP_NAME="BugHive"
APP_VERSION="1.0.0"

# Use "developing" locally and "production" for release builds.
APP_ENV="developing"
APP_DEBUG=true

APP_URL="bughive://auth-callback"
API_BASE_URL="https://your-api.com"

# --- Supabase (required) ---
# From Supabase dashboard → Project Settings → Data API / API Keys.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
# The publishable/anon key ONLY — never the service_role key.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- GitHub OAuth (required) ---
# Must match a redirect URL registered in Supabase → Auth → URL Configuration.
GITHUB_OAUTH_REDIRECT_URL="bughive://auth-callback"

ASSET_PATH="assets"
SHOW_SPLASH_SCREEN=false
DEFAULT_LOCALE="en"
DEBUG_TRANSLATIONS=false
USE_DEV_PANEL="false"

# Nylo app encryption key. Generate one with: dart run nylo_framework:main make:key
APP_KEY=
